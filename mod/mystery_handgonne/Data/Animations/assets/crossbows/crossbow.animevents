<?xml version="1.0" encoding="us-ascii"?>
<!-- OVERRIDE of the vanilla crossbow.animevents (all crossbows use crossbow.chr, and a copied .chr gets no
     animations, so this is the only place weapon shot events can go). Vanilla events are kept as they are.
     Our events carry model="objects/weapons/mystery_handgonne/mystery_handgonne.cdf": the "model" field limits an event to the
     character loaded from that file (tested: the gun shot plays only on this gun, not on vanilla
     crossbows; the path must include "objects/"). All three forged versions use that one cdf.
     Smoke offset = the Henry's muzzle on crossbow.chr (tools/blender_make_skin.py prints it). -->
<anim_event_list>
  <animation name="animations/assets/crossbows/crossbow_shot.caf">
    <event name="audio_trigger" time="0.0025" endTime="0.0025" parameter="c_w_crossbow_shot" bone="Crossbow_trigger_end" offset="0,0,0" dir="0,0,0" model="" />
    <event name="audio_trigger" time="0.0025" endTime="0.0025" parameter="c_f_firearm_shot" bone="Crossbow_trigger_end" offset="0,0,0" dir="0,0,0" model="objects/weapons/mystery_handgonne/mystery_handgonne.cdf" />
    <event name="effect" time="0.0025" endTime="0.34" parameter="firearms.hand_cannon.frontParticleEmit" bone="Asset_Crossbow" offset="0,0.528,0.054" dir="0,0,0" model="objects/weapons/mystery_handgonne/mystery_handgonne.cdf" />
  </animation>
  <animation name="animations/assets/crossbows/crossbow_palisade_lean_shoot.caf">
    <event name="audio_trigger" time="0.0025" endTime="0.0025" parameter="c_w_crossbow_shot" bone="Crossbow_trigger_end" offset="0,0,0" dir="0,0,0" model="" />
    <event name="audio_trigger" time="0.0025" endTime="0.0025" parameter="c_f_firearm_shot" bone="Crossbow_trigger_end" offset="0,0,0" dir="0,0,0" model="objects/weapons/mystery_handgonne/mystery_handgonne.cdf" />
    <event name="effect" time="0.0025" endTime="0.34" parameter="firearms.hand_cannon.frontParticleEmit" bone="Asset_Crossbow" offset="0,0.528,0.054" dir="0,0,0" model="objects/weapons/mystery_handgonne/mystery_handgonne.cdf" />
  </animation>
  <animation name="animations/assets/crossbows/crossbow_horse_shot_over.caf">
    <event name="audio_trigger" time="0" endTime="0" parameter="c_w_crossbow_shot" bone="Crossbow_trigger_end" offset="0,0,0" dir="0,0,0" model="" />
    <event name="audio_trigger" time="0" endTime="0" parameter="c_f_firearm_shot" bone="Crossbow_trigger_end" offset="0,0,0" dir="0,0,0" model="objects/weapons/mystery_handgonne/mystery_handgonne.cdf" />
    <event name="effect" time="0" endTime="0.34" parameter="firearms.hand_cannon.frontParticleEmit" bone="Asset_Crossbow" offset="0,0.528,0.054" dir="0,0,0" model="objects/weapons/mystery_handgonne/mystery_handgonne.cdf" />
  </animation>
  <animation name="animations/assets/crossbows/crossbow_stealth_shot.caf">
    <event name="audio_trigger" time="0.0005" endTime="0.0005" parameter="c_w_crossbow_shot" bone="Crossbow_trigger_end" offset="0,0,0" dir="0,0,0" model="" />
    <event name="audio_trigger" time="0.0005" endTime="0.0005" parameter="c_f_firearm_shot" bone="Crossbow_trigger_end" offset="0,0,0" dir="0,0,0" model="objects/weapons/mystery_handgonne/mystery_handgonne.cdf" />
    <event name="effect" time="0.0005" endTime="0.34" parameter="firearms.hand_cannon.frontParticleEmit" bone="Asset_Crossbow" offset="0,0.528,0.054" dir="0,0,0" model="objects/weapons/mystery_handgonne/mystery_handgonne.cdf" />
  </animation>
  <animation name="animations/assets/crossbows/crossbow_shot_over.caf">
    <event name="audio_trigger" time="0.004117647" endTime="0.004117647" parameter="c_w_crossbow_shot" bone="Crossbow_trigger_end" offset="0,0,0" dir="0,0,0" model="" />
    <event name="audio_trigger" time="0.004117647" endTime="0.004117647" parameter="c_f_firearm_shot" bone="Crossbow_trigger_end" offset="0,0,0" dir="0,0,0" model="objects/weapons/mystery_handgonne/mystery_handgonne.cdf" />
    <event name="effect" time="0.004117647" endTime="0.34" parameter="firearms.hand_cannon.frontParticleEmit" bone="Asset_Crossbow" offset="0,0.528,0.054" dir="0,0,0" model="objects/weapons/mystery_handgonne/mystery_handgonne.cdf" />
  </animation>
</anim_event_list>
